# Copia este archivo como .env y reemplaza todos los valores CHANGE_ME.
# Use contraseñas formadas por letras, números, punto, guion y guion bajo.

MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_2026

AUTH_DB_PASSWORD=CHANGE_ME_auth_db_2026
CLIENTES_DB_PASSWORD=CHANGE_ME_clientes_db_2026
VETERINARIOS_DB_PASSWORD=CHANGE_ME_veterinarios_db_2026
MASCOTAS_DB_PASSWORD=CHANGE_ME_mascotas_db_2026
CITAS_DB_PASSWORD=CHANGE_ME_citas_db_2026
CONSULTAS_DB_PASSWORD=CHANGE_ME_consultas_db_2026
VACUNAS_DB_PASSWORD=CHANGE_ME_vacunas_db_2026

# Debe tener al menos 32 caracteres y ser igual para todos los servicios.
JWT_SECRET=CHANGE_ME_dawivet_jwt_shared_secret_2026

# Opcional. Puede sobrescribirse en .env según la memoria disponible.
JAVA_TOOL_OPTIONS=-Xms64m -Xmx384m -Djava.security.egd=file:/dev/./urandom
